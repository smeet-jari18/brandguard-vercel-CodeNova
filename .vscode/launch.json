{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BrandGuard — Live HTTPS Backend",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE=${input:apiBase}"
      ]
    }
  ],
  "inputs": [{"id":"apiBase","type":"promptString","description":"API URL (use your deployed HTTPS domain for a phone)","default":"http://127.0.0.1:8000"}]
}
